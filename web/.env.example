# web/.env.example: copy to web/.env.local if you need to override. All optional.
# Base URL for uploaded media the dashboard links to (dev: Caddy serves .data/media here).
VITE_MEDIA_BASE_URL=http://media.binarysust.localhost
# Set by `make web` when Vite sits behind Caddy on port 80; leave unset for plain `pnpm dev`.
# VITE_HMR_CLIENT_PORT=80
# Without Caddy, `pnpm dev` proxies /api and /healthz here.
# API_ORIGIN=http://localhost:8080
