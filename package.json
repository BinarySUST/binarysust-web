{
  "name": "binarysust",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm db:up && dotenv -e .env -- turbo run dev",
    "build": "turbo run build",
    "test": "dotenv -e .env -- turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write . && turbo run format",
    "format:check": "prettier --check .",
    "gen": "turbo run gen",
    "db:up": "pnpm env:init && docker compose -f infra/docker/compose.yaml up -d --wait",
    "db:down": "docker compose -f infra/docker/compose.yaml down",
    "db:migrate": "pnpm db:up && dotenv -e .env -- go -C apps/api run ./cmd/server migrate",
    "db:seed": "pnpm db:migrate && dotenv -e .env -- go -C apps/api run ./cmd/seed",
    "db:reset": "docker compose -f infra/docker/compose.yaml down --volumes && pnpm db:seed",
    "snapshot": "dotenv -e .env -- go -C apps/api run ./cmd/snapshot -out ../web",
    "env:init": "[ -f .env ] || cp .env.example .env; mkdir -p .data/media",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "dotenv-cli": "11.1.0",
    "eslint": "10.14.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "turbo": "2.11.10"
  }
}
