# Production env for the Go API on the VPS. setup.sh copies this to /etc/binarysust-api.env (root, 0600)
# the first time; fill it in there with `sudo nano /etc/binarysust-api.env`. Never commit real values.
# PORT is set by the systemd unit (8081).

# Supabase → Project Settings → Database → Connection string → **Session pooler** (IPv4, supports
# prepared statements). The direct connection is IPv6-only on the free plan.
DATABASE_URL=
PUBLIC_URL=https://binarysust.org
# >= 32 random bytes: openssl rand -base64 48
EKMAN_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MEDIA_BASE_URL=https://media.binarysust.org
GITHUB_MEDIA_REPOSITORY=BinarySUST/binarysust-media
GITHUB_MEDIA_TOKEN=

# Receives repository_dispatch "publish" after content writes.
GITHUB_REPOSITORY=BinarySUST/binarysust-web
GITHUB_DISPATCH_TOKEN=

# Optional: empty logs mail instead of sending it.
BREVO_API_KEY=
MAIL_FROM=binary.sust@gmail.com
