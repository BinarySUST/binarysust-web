# Production env for the Go API on the VPS. setup.sh copies this to /etc/binarysust-api.env (root, 0600)
# the first time; fill it in there with `sudo nano /etc/binarysust-api.env`. Never commit real values.
# PORT is set by the systemd unit (8081).

# --- Required -----------------------------------------------------------------------------------------------
# Supabase → Connect → Direct → Session pooler (IPv4, supports prepared statements). Fill in the password.
# The direct connection and the transaction pooler are IPv6-only on the free plan; the VPS has no IPv6.
DATABASE_URL=

# --- Optional: the API boots without these; each one turns on a feature --------------------------------------
# Origin of the site. Sign-in redirects back here and emails link to it.
# PUBLIC_URL=https://www.binarysust.org

# >= 32 random bytes (openssl rand -base64 48). Unset: a per-process key, so a sign-in in flight breaks on restart.
# EKMAN_SECRET=

# Google sign-in. Unset: no Google sign-in.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Uploads are committed to this repository and served from MEDIA_BASE_URL. Unset: uploads are off.
# MEDIA_BASE_URL=https://media.binarysust.org
# GITHUB_MEDIA_REPOSITORY=BinarySUST/binarysust-media
# GITHUB_MEDIA_TOKEN=

# Fires repository_dispatch "publish" after content writes. Unset: republish the site by hand.
# GITHUB_REPOSITORY=BinarySUST/binarysust-web
# GITHUB_DISPATCH_TOKEN=

# Mail. Unset BREVO_API_KEY: emails are logged instead of sent.
# BREVO_API_KEY=
# MAIL_FROM=binary.sust@gmail.com
