# Local config for the Go API. Copy to apps/api/.env (git-ignored; `pnpm dev` creates it from this file).
# The root scripts load it with dotenv-cli (`dotenv -e apps/api/.env -- …`): `dev`, `test`, `db:*`, `snapshot`.
# Production does not use this file: on the VPS the API reads /etc/binarysust-api.env (infra/vps/).
# The API listens on :8080 (Caddy's upstream for /api/*).

# --- Required -----------------------------------------------------------------------------------------------
# The Docker Postgres from `pnpm db:up`.
DATABASE_URL=postgres://binary:binary@localhost:5433/binarysust?sslmode=disable

# --- Optional: the API boots without these. The values set below make local dev match production. --------
# Origin of the site; also enables dev sign-in (below) because it is a *.localhost origin.
PUBLIC_URL=http://binarysust.localhost

# Dev sign-in without Google: this email is signed in as an admin on /api/v1/auth/dev/start.
# Only honored when PUBLIC_URL is a *.localhost / localhost origin.
DEV_ADMIN_EMAIL=admin@binarysust.local

# Local uploads: stored here, served by Caddy at media.binarysust.localhost. Relative to apps/api/.
MEDIA_DIR=../../.data/media
MEDIA_BASE_URL=http://media.binarysust.localhost

# >= 32 bytes. Unset: a per-process key, so a sign-in in flight breaks when the API restarts.
# EKMAN_SECRET=

# Google OAuth (console.cloud.google.com, no billing needed). Unset: Google sign-in is off.
# The prod client only allows https://www.binarysust.org/api/v1/auth/google/callback; use DEV_ADMIN_EMAIL locally.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Mail. Unset BREVO_API_KEY: emails are logged to the API console.
# BREVO_API_KEY=
# MAIL_FROM=binary.sust@gmail.com

# Go tests that need Postgres (each test gets its own schema). Unset: those tests are skipped.
EKMAN_TEST_DATABASE_URL=postgres://binary:binary@localhost:5433/binarysust?sslmode=disable
