# Local config for the web dev server. Copy to apps/web/.env (git-ignored; `pnpm dev` creates it from this
# file). Vite loads it: VITE_* reach the browser bundle, and vite.config.ts reads the rest. Production builds
# do not use it (CI sets SITE_URL; API_ORIGIN for the deployed proxy is in wrangler.toml).

# Base URL for uploaded media the dashboard links to (dev: Caddy serves .data/media here).
VITE_MEDIA_BASE_URL=http://media.binarysust.localhost

# `pnpm dev` puts Caddy on port 80 in front of Vite, so HMR's websocket connects through it.
# Remove it to open Vite directly on http://localhost:3000.
VITE_HMR_CLIENT_PORT=80

# Without Caddy, Vite proxies /api and /healthz here.
# API_ORIGIN=http://localhost:8080
