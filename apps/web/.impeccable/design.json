  "narrative": {
    "northStar": "The Engineering Drawing Sheet",
    "overview": "A well-made engineering document crossed with a developer tool: hairline frames, title blocks for facts, precise mono metadata, real club data shown the way engineers show it (a contribution graph, a code window, a dated schedule). Calm, credible, university-grade. Ornament lives only in the hero background (a faint grid and a pointer-following glow); the text column carries none.",
    "keyCharacteristics": [
      "Light and dark are both first-class; light is the default, the system preference decides until the visitor picks.",
      "One accent (brand green) for action and \"active\"; everything else is tinted neutral.",
      "One 1px hairline weight for every rule, border and frame; depth by flat plane steps only.",
      "Archivo semi-expanded for display, JetBrains Mono for anything a machine would print."
    ],
    "rules": [
      {
        "name": "The One Spark Rule",
        "body": "Brand red appears once: the live dot. It is never a fill, rule, heading or button.",
        "section": "colors"
      },
      {
        "name": "The Legacy Alias Rule",
        "body": "The dashboard still uses old names; keep them resolving, never use them on new public surfaces: --vermilion / text-vermilion = danger, --yellow / yellow = warn, --parrot / parrot = ok, --font-code = mono.",
        "section": "colors"
      },
      {
        "name": "The Inline Index Rule",
        "body": "No eyebrows or kickers above headings. A section's mono index (\"01\") sits on the heading's own baseline, in accent ink, with a strong hairline running beneath to the optional action.",
        "section": "typography"
      },
      {
        "name": "The Hairline Rule",
        "body": "Every rule, border and frame is 1px, in line or line-strong. The only 2px stroke is the focus ring.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do give every technical device a real payload: data, code or metadata.",
      "Do keep focus visible: 2px accent outline, 3px offset, everywhere.",
      "Do verify AA contrast for every new text/background pair in both themes.",
      "Do keep the print stylesheet dropping chrome so portfolios print as a CV."
    ],
    "donts": [
      "Don't add eyebrow or kicker labels above headings.",
      "Don't use shadows, glass, gradient fills or gradient text.",
      "Don't use brand red for anything but the live dot.",
      "Don't add decorative binary, ASCII plots or fake terminal output; the ASCII/binary plot was rejected as \"silly, makes no sense\".",
      "Don't bring back painted, hand-lettered or playful display faces."
    ]
  }
}
