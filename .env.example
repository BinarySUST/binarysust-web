# Copy to .env (git-ignored; `pnpm dev` creates it from this file). The root scripts load it with
# dotenv-cli (`dotenv -e .env -- turbo run ...`), so the API, the web dev server, tests and db:* scripts
# all read this one file. The API listens on :8080 and the web dev server on :3000 (Caddy's upstreams).

DATABASE_URL=postgres://binary:binary@localhost:5433/binarysust?sslmode=disable
PUBLIC_URL=http://binarysust.localhost
EKMAN_SECRET=dev-only-change-me-32-bytes-minimum!!

# Google OAuth (console.cloud.google.com, no billing needed).
# Authorized redirect URI: http://binarysust.localhost/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dev sign-in without Google: this email is signed in as an admin on /api/v1/auth/dev/start.
# Only honored when PUBLIC_URL is a *.localhost / localhost origin.
DEV_ADMIN_EMAIL=admin@binarysust.local

# Local uploads: stored here, served by Caddy at media.binarysust.localhost (prod: media.binarysust.org).
# MEDIA_DIR is relative to apps/api/, where the server runs.
MEDIA_DIR=../../.data/media
MEDIA_BASE_URL=http://media.binarysust.localhost

# Mail: empty BREVO_API_KEY logs emails to the API console.
BREVO_API_KEY=
MAIL_FROM=binary.sust@gmail.com

# Web dev server behind Caddy (port 80): Vite's HMR websocket connects through Caddy.
VITE_HMR_CLIENT_PORT=80

# Go tests that need Postgres (each test gets its own schema); unset skips them.
EKMAN_TEST_DATABASE_URL=postgres://binary:binary@localhost:5433/binarysust?sslmode=disable
